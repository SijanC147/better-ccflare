{
	"private": true,
	"name": "better-ccflare",
	"description": "A load balancer proxy for Claude Code with intelligent load balancing across multiple accounts",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"better-ccflare": "bun run build && bun run cli",
		"cli": "bun run apps/cli/src/main.ts",
		"dev": "bun run cli",
		"start": "bun run apps/server/src/server.ts",
		"server": "bun run apps/server/src/server.ts",
		"dev:server": "bun run --hot apps/server/src/server.ts",
		"dev:dashboard": "bun --hot packages/dashboard-web/src/index.tsx",
		"typecheck": "bunx tsc --noEmit && bun run typecheck:tests",
		"check:boolean-widening": "bun run scripts/check-boolean-widening.ts",
		"check:optional-chain-silent-skip": "bun run scripts/check-optional-chain-silent-skip.ts",
		"typecheck:tests": "bun run typecheck:dashboard && bun run typecheck:config && bun run typecheck:claude-code-discovery && bun run typecheck:logger && bun run typecheck:security && bun run typecheck:types && bun run typecheck:load-balancer && bun run typecheck:database && bun run typecheck:agents && bun run typecheck:cli-commands && bun run typecheck:oauth-flow && bun run typecheck:core && bun run typecheck:openai-formats && bun run typecheck:openai-responses-adapter && bun run typecheck:http-api && bun run typecheck:proxy && bun run typecheck:http-common && bun run typecheck:errors && bun run typecheck:ui-common && bun run typecheck:ui-constants && bun run typecheck:providers && bun run typecheck:server",
		"typecheck:dashboard": "bunx tsc --noEmit -p packages/dashboard-web/tsconfig.json",
		"typecheck:config": "bunx tsc --noEmit -p packages/config/tsconfig.json",
		"typecheck:claude-code-discovery": "bunx tsc --noEmit -p packages/claude-code-discovery/tsconfig.json",
		"typecheck:logger": "bunx tsc --noEmit -p packages/logger/tsconfig.json",
		"typecheck:security": "bunx tsc --noEmit -p packages/security/tsconfig.json",
		"typecheck:types": "bunx tsc --noEmit -p packages/types/tsconfig.json",
		"typecheck:load-balancer": "bunx tsc --noEmit -p packages/load-balancer/tsconfig.json",
		"typecheck:database": "bunx tsc --noEmit -p packages/database/tsconfig.json",
		"typecheck:agents": "bunx tsc --noEmit -p packages/agents/tsconfig.json",
		"typecheck:cli-commands": "bunx tsc --noEmit -p packages/cli-commands/tsconfig.json",
		"typecheck:oauth-flow": "bunx tsc --noEmit -p packages/oauth-flow/tsconfig.json",
		"typecheck:core": "bunx tsc --noEmit -p packages/core/tsconfig.json",
		"typecheck:openai-formats": "bunx tsc --noEmit -p packages/openai-formats/tsconfig.json",
		"typecheck:openai-responses-adapter": "bunx tsc --noEmit -p packages/openai-responses-adapter/tsconfig.json",
		"typecheck:http-api": "bunx tsc --noEmit -p packages/http-api/tsconfig.json",
		"typecheck:proxy": "bunx tsc --noEmit -p packages/proxy/tsconfig.json",
		"typecheck:http-common": "bunx tsc --noEmit -p packages/http-common/tsconfig.json",
		"typecheck:errors": "bunx tsc --noEmit -p packages/errors/tsconfig.json",
		"typecheck:ui-common": "bunx tsc --noEmit -p packages/ui-common/tsconfig.json",
		"typecheck:ui-constants": "bunx tsc --noEmit -p packages/ui-constants/tsconfig.json",
		"typecheck:providers": "bunx tsc --noEmit -p packages/providers/tsconfig.json",
		"typecheck:server": "bunx tsc --noEmit -p apps/server/tsconfig.json",
		"test": "bun test",
		"test:cli": "bun test apps/cli/__tests__",
		"build": "bun run build:cli",
		"build:dashboard": "bun run --cwd packages/dashboard-web build",
		"build:cli": "bun run --cwd apps/cli build",
		"build:lander": "bun run --cwd apps/lander build",
		"format": "bunx biome format --write .",
		"lint": "bunx --bun biome check --write --unsafe ."
	},
	"engines": {
		"bun": ">=1.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@types/bun": "1.3.14",
		"bun-types": "1.3.14",
		"typescript": "^6.0.2"
	},
	"version": "3.24.0"
}
