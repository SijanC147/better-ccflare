{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		// `exactOptionalPropertyTypes` rejects an explicit `undefined` on an
		// optional member (SB23-2456). Set here rather than inherited because the
		// root config does not set it yet: proxy and the programs that import it
		// still carry sites. It applies to every file this program reaches
		// through the `@better-ccflare/*` path map, so a violation in
		// `packages/types` fails this target as well.
		"exactOptionalPropertyTypes": true,
		"noUncheckedSideEffectImports": false,
		// `paths` REPLACES the inherited map rather than merging with it, so
		// the root's `@better-ccflare/*` entries have to be restated here or
		// every workspace import falls back to node_modules. That fallback
		// resolves for packages whose `main` is `./src/index.ts` and fails for
		// `@better-ccflare/agents`, whose manifest points at an unbuilt
		// `dist/`, which is why a bare package-level run reported TS2307 in
		// packages/proxy, which `packages/types/src/context.ts` used to pull in
		// through the type graph even though no dashboard-web source file
		// imports it. That import is gone as of SB23-2306. Measured with
		// `--explainFiles`: proxy went 47 files to 0, providers 74 to 0, and
		// `@better-ccflare/agents` 4 to 0, so the TS2307 that first motivated
		// restating this map can no longer occur. The map is still required by
		// the replacement rule in the first sentence, and by `@/*`.
		// Measured: adding these leaves `bun run build:dashboard` output
		// byte-identical at 19,293,156 bytes across 23 files.
		"paths": {
			"@/*": ["./src/*"],
			"@better-ccflare/*": ["../../packages/*/src"],
			"@better-ccflare/server": ["../../apps/server/src/server.ts"],
			"@better-ccflare/dashboard-web/dist/*": ["../dashboard-web/dist/*"]
		}
	},
	// `build.ts` and `embed.ts` are the package's own build scripts and sat
	// outside every program until SB23-3689. Listed here rather than in a
	// new target because `typecheck:dashboard` is already in the root chain.
	// Measured: `bun run build:dashboard` output is byte-identical with and
	// without these two entries, 23 files, 20,161,626 bytes.
	"include": ["src/**/*", "build.ts", "embed.ts"],
	"exclude": ["dist", "node_modules"]
}
