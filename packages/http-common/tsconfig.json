{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		// `exactOptionalPropertyTypes` rejects an explicit `undefined` on an optional
		// member, which closes the `Partial<T>` hole in fixture factories such as
		// `makeAccount` and `makeZaiUsage` (SB23-2456). It applies to every file this
		// program reaches through the `@better-ccflare/*` path map, so a violation in
		// `packages/core` fails this target as well as `typecheck:core`. The root
		// config does not set it yet, because proxy and the programs that import it
		// still carry sites; set per package until they reach zero.
		"exactOptionalPropertyTypes": true
	},
	"include": ["src/**/*"],
	// `exclude` REPLACES the inherited value rather than merging, so stating it
	// here overrides the root config's `**/__tests__`, `**/*.test.ts` and
	// `**/*.test.tsx` entries and brings this package's test files into the
	// program. Same mechanism as packages/config (SB23-2304). Wired into the
	// root `typecheck` script; without that script entry the gate never runs.
	//
	// `rootDir: "./src"` and `outDir: "./dist"` were removed here (SB23-2353).
	// They raised 90 TS6059 errors, one per source file reached through the
	// `@better-ccflare/*` path map, because every one of those files lives
	// outside this package's `src`. The count was identical at 90 with the test
	// exclusion on and off, which is what proves `rootDir` was the cause rather
	// than the tests. Removing the pair emits nothing differently: the root
	// config sets `noEmit: true` and this file inherits it, this package's own
	// `typecheck` script passes `--noEmit`, no `dist/` exists for any package,
	// and the shipped binary is built by `bun build --compile` from
	// `apps/cli/src/main.ts` rather than by `tsc`.
	//
	// The inherited `noEmit: true` is the load-bearing fact, not how scripts
	// are spelled: not every `tsc` invocation passes `--noEmit`.
	// `packages/agents` declares a bare `tsc` build and a `tsc --watch` dev
	// script, and they emit nothing only because that tsconfig also extends
	// the root without overriding `noEmit` (SB23-2439).
	"exclude": ["node_modules", "dist"]
}
