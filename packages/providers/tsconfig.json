{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		// `exactOptionalPropertyTypes` rejects an explicit `undefined` on an optional
		// member, which closes the `Partial<T>` hole in fixture factories such as
		// `makeAccount` and `makeZaiUsage` (SB23-2456). It applies to every file this
		// program reaches through the `@better-ccflare/*` path map, so a violation in
		// `packages/core` fails this target as well as `typecheck:core`. The root
		// config does not set it yet, because proxy and the programs that import it
		// still carry sites; set per package until they reach zero.
		"exactOptionalPropertyTypes": true
	},
	"include": ["src/**/*"],
	// `exclude` REPLACES the inherited value rather than merging, so stating it
	// here overrides the root config's `**/__tests__`, `**/*.test.ts` and
	// `**/*.test.tsx` entries and brings this package's test files into the
	// program. Same mechanism as packages/security (SB23-2306). Wired into the
	// root `typecheck` script; without that script entry the gate never runs,
	// which is the state packages/errors was in until SB23-2387.
	//
	// The 87 errors this closes were partitioned across SB23-2441 through
	// SB23-2445. The count was never the whole population: an `as Account`
	// cast keeps a file out of it rather than failing it, so two casts in
	// providers/codex were hiding three further errors that the visible
	// count did not reach (SB23-2449). Grep for casts before trusting a
	// zero here.
	"exclude": ["node_modules", "dist"]
}
