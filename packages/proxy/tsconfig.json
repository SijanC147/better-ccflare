{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler"
	},
	"include": ["src/**/*"],
	// `exclude` REPLACES the inherited value rather than merging, so stating it
	// here overrides the root config's `**/__tests__`, `**/*.test.ts` and
	// `**/*.test.tsx` entries and brings this package's test files into the
	// program. Same mechanism as packages/http-api (SB23-2304). Wired into the
	// root `typecheck` script; without that script entry the gate never runs.
	//
	// All 108 of this package's test files are typechecked. SB23-2344 gated 87 of
	// them and named the remaining 21 here; SB23-2385 cleared those 21 and the
	// 63 errors they carried, so nothing is listed any more and a new test file
	// is gated by default.
	"exclude": ["node_modules", "dist"]
}
